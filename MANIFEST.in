# Include documentation and license files
include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include pyproject.toml

# Include all Python files in the circe package
recursive-include circe *.py

# Include type hints marker
include circe/py.typed

# Exclude test files
recursive-exclude tests *
exclude tests

# Exclude Java source
recursive-exclude circe-be *
exclude circe-be

# Exclude temporary and build files
exclude *.json
exclude *.R
exclude *.sql
exclude .gitignore
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * .DS_Store

# Exclude coverage and test results
exclude coverage.xml
exclude coverage.json
recursive-exclude htmlcov *
exclude htmlcov

# Exclude build directories
recursive-exclude build *
exclude build
recursive-exclude dist *
exclude dist
recursive-exclude *.egg-info *
